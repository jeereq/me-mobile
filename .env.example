# Adresse de ton serveur me-api (ex. https://me-api.onrender.com).
# Laisser vide pour le mode local : tout reste sur le téléphone, sans comptes ni IA.
# Sur un téléphone, n'utilise pas localhost : mets l'adresse IP de ton ordinateur (ex. http://192.168.1.20:4000).
EXPO_PUBLIC_API_URL=https://me-api-ua1p.onrender.com

# Adresse de l'app web (ex. https://me.vercel.app) : liens vers la confidentialité et les conditions dans l'app installée.
EXPO_PUBLIC_SITE_URL=
